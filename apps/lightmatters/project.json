{
  "name": "lightmatters",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/lightmatters/src",
  "tags": ["scope:app"],
  "targets": {
    "copy-mathjax": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{workspaceRoot}/node_modules/mathjax/**/*"],
      "outputs": ["{workspaceRoot}/apps/lightmatters/public/mathjax"],
      "options": {
        "command": "rm -rf apps/lightmatters/public/mathjax && cp -r node_modules/mathjax apps/lightmatters/public/mathjax"
      }
    },
    "build": {
      "dependsOn": ["copy-mathjax"],
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/lightmatters",
        "browser": "apps/lightmatters/src/main.ts",
        "tsConfig": "apps/lightmatters/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/lightmatters/public"
          }
        ],
        "styles": ["apps/lightmatters/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "dependsOn": ["copy-mathjax"],
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "lightmatters:build:production"
        },
        "development": {
          "buildTarget": "lightmatters:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/lightmatters/jest.config.cts",
        "tsConfig": "apps/lightmatters/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "lightmatters:build",
        "port": 4200,
        "staticFilePath": "dist/apps/lightmatters/browser",
        "spa": true
      }
    }
  }
}
